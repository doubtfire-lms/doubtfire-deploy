# --- SITE AND TLS ---

ONTRACK_SITE_ADDRESS=example.com
# Uncomment to allow this Moodle origin to embed OnTrack.
# When unset, framing is restricted to OnTrack's own origin.
# ONTRACK_MOODLE_ORIGIN=https://moodle.example.com
# --- UPSTREAM SERVICES ---

# List preferred API upstreams first; Caddy falls back from left to right.
ONTRACK_API_UPSTREAMS=apiserver-green:3000 apiserver:3000
ONTRACK_LTI_UPSTREAM=lti:3001
ONTRACK_WEB_UPSTREAM=webserver:80


# --- SIDEKIQ WEB DASHBOARD ---

# The dashboard remains disabled unless this is true and both credentials are set.
ENABLE_SIDEKIQ_WEB=false
SIDEKIQ_WEB_USERNAME=
# Generate with: caddy hash-password --plaintext 'your_password'
# Paste the result between single quotes so Docker Compose preserves its dollar signs:
# SIDEKIQ_WEB_PASSWORD_HASH='$2a$14$...'
SIDEKIQ_WEB_PASSWORD_HASH=


# --- PROTECTED FILE SERVING ---

# Must match the value in ../api/.env.production.
CADDY_DOWNLOAD_AUTH_SECRET=replace-with-a-long-random-secret

# Leave false to use the existing Rails file responses.
SERVE_VIA_CADDY=false
