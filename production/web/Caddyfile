example.com {
    # Compose policies from readable sections while emitting one header value.
    vars {
        # Browser capabilities used by OnTrack and explicitly disabled otherwise.
        permissions_capture "camera=(self), microphone=(self), fullscreen=(self)"
        permissions_clipboard "clipboard-read=(self), clipboard-write=(self)"
        permissions_disabled "geolocation=(), payment=(), usb=()"

        # Compatibility policy for trusted uploaded unit sites. It permits
        # inline code and remote HTTPS assets, but deliberately omits unsafe-eval.
        csp_unit_core "default-src 'self' https: data: blob:; base-uri 'self'; object-src 'self' https: data: blob:;"
        csp_unit_code "script-src 'self' https: 'unsafe-inline'; style-src 'self' https: 'unsafe-inline';"
        csp_unit_content "font-src 'self' https: data:; img-src 'self' https: data: blob:; media-src 'self' https: data: blob:;"
        csp_unit_network "connect-src 'self' https: blob:; worker-src 'self' blob:;"
        csp_unit_frames "child-src 'self' https: blob:; frame-src 'self' https: blob:; frame-ancestors 'self';"
        csp_unit_navigation "form-action 'self' https:; upgrade-insecure-requests"

        # Strict policy for OnTrack, JPlag, LTI, and ordinary API responses.
        csp_standard_core "default-src 'self'; base-uri 'self'; object-src 'self' blob:;"
        csp_standard_code "script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com;"
        csp_standard_content "font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob:;"
        csp_standard_network "connect-src 'self' blob: https://api.github.com; worker-src 'self' blob:;"
        csp_standard_frames "child-src 'self' blob:; frame-src 'self' blob:; frame-ancestors 'self' https:;"
        csp_standard_navigation "form-action 'self' https:; manifest-src 'self'; upgrade-insecure-requests"
    }

    header {
        -Server
        -Via
        Strict-Transport-Security "max-age=31536000"
        Permissions-Policy "{vars.permissions_capture}, {vars.permissions_clipboard}, {vars.permissions_disabled}"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Content-Type-Options "nosniff"
        X-Permitted-Cross-Domain-Policies "none"
        X-XSS-Protection "0"
    }

    # Uploaded unit sites are trusted course content and can contain inline
    # scripts/styles, nested frames, and remote HTTPS assets. Keep that
    # compatibility exception scoped to the authenticated content endpoint;
    # dynamic evaluation remains disabled.
    @unitContent path_regexp ^/api/units/[0-9]+/content$
    header @unitContent >Content-Security-Policy "{vars.csp_unit_core} {vars.csp_unit_code} {vars.csp_unit_content} {vars.csp_unit_network} {vars.csp_unit_frames} {vars.csp_unit_navigation}"

    # The application shell, JPlag, LTI API, and ordinary API responses use a
    # strict policy.
    @standardContent not path_regexp ^/api/units/[0-9]+/content$
    header @standardContent >Content-Security-Policy "{vars.csp_standard_core} {vars.csp_standard_code} {vars.csp_standard_content} {vars.csp_standard_network} {vars.csp_standard_frames} {vars.csp_standard_navigation}"

    tls /etc/caddy/cert.crt /etc/caddy/key.key

    # Optional Sidekiq dashboard. Generate a password hash with:
    # caddy hash-password --plaintext 'your_password'
    # Then uncomment both blocks and reload Caddy.
    # basic_auth /sidekiq/* {
    #     your-username your-hashed-password
    # }
    # reverse_proxy /sidekiq/* apiserver-green:3000 apiserver:3000

    # Prefer the green API during deployments, then fall back to the primary API.
    # Active health checks fail unavailable upstreams quickly.
    reverse_proxy /api/* {
        to apiserver-green:3000 apiserver:3000

        lb_policy first
        lb_retries 2

        health_uri /health
        health_timeout 2s
        health_interval 3s
    }

    # Expose the Rails health check at /api/health and /health.
    rewrite /api/health /health

    reverse_proxy /health {
        to apiserver-green:3000 apiserver:3000

        lb_policy first
        lb_retries 2

        health_uri /health
        health_timeout 2s
        health_interval 3s
    }

    # Route LTI requests to the LTI service.
    reverse_proxy /lti/api/* lti:3001

    # Serve the Angular application for all remaining requests.
    reverse_proxy /* webserver:80
}
