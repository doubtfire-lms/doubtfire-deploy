# --- APPLICATION ---

RAILS_ENV=production
DF_LOG_TO_STDOUT=false


# --- DATABASE SETTINGS ---

# Connection
DF_PRODUCTION_DB_ADAPTER=mysql2
DF_PRODUCTION_DB_HOST=ontrack-db
DF_PRODUCTION_DB_DATABASE=doubtfire
DF_PRODUCTION_DB_USERNAME=dfire
DF_PRODUCTION_DB_PASSWORD=pwd


# --- SECRETS AND ENCRYPTION ---

# Rails and authentication secrets
DF_SECRET_KEY_BASE=test-secret-key
DF_SECRET_KEY_ATTR=test-secret-key
DF_SECRET_KEY_DEVISE=test-secret-key

# Active Record encryption
DF_ENCRYPTION_PRIMARY_KEY=AMLOMYA5GV8B4fTK3VKMhVGn8WdvUW8g
DF_ENCRYPTION_DETERMINISTIC_KEY=anlmuJ6cB3bN3biXRbYvmPsC5ALPFqGG
DF_ENCRYPTION_KEY_DERIVATION_SALT=hzPR8D4qpOnAg7VeAhkhWw6JmmzKJB10


# --- STORAGE AND PROCESSING ---

# Student work and archiving
DF_STUDENT_WORK_DIR=/student-work
DF_ARCHIVE_DIR=/student-work/archive
DF_ARCHIVE_UNITS=false
DF_UNIT_ARCHIVE_PERIOD=2

# PDF generation
DF_MAX_PDF_GEN_PROCESSES=2
LATEX_CONTAINER_NAME=texlive-container
LATEX_BUILD_PATH=/texlive/shell/latex_build.sh

# File uploads
DF_MAX_FILE_SIZE=10_000_000 # 10 MB
DF_ZIP_ENTRY_LIMIT=1000
DF_ZIP_COMPRESSION_RATIO_LIMIT=100
DF_ZIP_UNCOMPRESSED_SIZE_MULTIPLIER=10

# Audio processing for voice comments and discussions
DF_FFMPEG_PATH=ffmpeg


# --- BACKGROUND JOBS ---

DF_REDIS_SIDEKIQ_URL=redis://redis-sidekiq:6379/0


# --- INSTITUTION SETTINGS ---

# Identity
DF_INSTITUTION_NAME=unifoo
DF_INSTITUTION_PRODUCT_NAME=OnTrack
DF_INSTITUTION_HOST=https://localhost
DF_INSTITUTION_EMAIL_DOMAIN=unifoo.edu.au
DF_COOKIE_DOMAIN=localhost

# Institution-specific configuration
DF_INSTITUTION_SETTINGS_RB=no_institution_setting.rb
# Use the mounted custom institution setting instead:
# DF_INSTITUTION_SETTINGS_RB=custom_institution_setting.rb

# Branding
DF_INSTITUTION_HAS_LOGO=false
DF_INSTITUTION_LOGO_URL=/assets/images/institution-logo.png
DF_INSTITUTION_LOGO_LINK_URL=https://example.edu

# Policies
# Empty values override the defaults in config/institution.yml with blank text.
DF_INSTITUTION_PRIVACY=
DF_INSTITUTION_PLAGIARISM=

# Access windows
DF_AUDITOR_UNIT_ACCESS_YEARS=2
DF_IMPORT_STUDENTS_WEEKS_BEFPRE=1


# --- AUTHENTICATION ---

# Method: aaf, saml, ldap, or database (development only)
DF_AUTH_METHOD=database

# Token lifetime
DF_ACCESS_TOKEN_EXPIRY_SECONDS=600 # 10 minutes
DF_REFRESH_TOKEN_EXPIRY_SECONDS=604800 # 7 days

# AAF Rapid Connect
DF_AAF_ISSUER_URL=https://rapid.test.aaf.edu.au
DF_AAF_AUDIENCE_URL=
DF_AAF_CALLBACK_URL=
DF_AAF_IDENTITY_PROVIDER_URL=
DF_AAF_UNIQUE_URL=
DF_AAF_AUTH_SIGNOUT_URL=
DF_SECRET_KEY_AAF=

# SAML
DF_SAML_METADATA_URL=
DF_SAML_METADATA_FILE_PATH=
DF_SAML_CONSUMER_SERVICE_URL=https://localhost/api/auth/jwt
DF_SAML_SP_ENTITY_ID=https://localhost
DF_SAML_IDP_TARGET_URL=https://login.microsoftonline.com/xxxx/saml2
DF_SAML_IDP_SIGNOUT_URL=
DF_SAML_IDP_CERT=

# Supported SAML NameID formats include: persistent, transient, emailAddress,
# unspecified, X509SubjectName, WindowsDomainQualifiedName, kerberos, and entity.
DF_SAML_IDP_SAML_NAME_IDENTIFIER_FORMAT=urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress

# LDAP
DF_LDAP_HOST=
DF_LDAP_PORT=
DF_LDAP_ATTRIBUTE=
DF_LDAP_BASE=
DF_LDAP_SSL=false
DF_LDAP_USE_ADMIN_TO_BIND=false
DF_LDAP_ADMIN_USER=
DF_LDAP_ADMIN_PWD=

# LTI
LTI_ENABLED=false
LTI_SHARED_API_SECRET=
# Refer to .env.lti.production for additional LTI configuration.


# --- EMAIL ---

# Delivery
DF_MAIL_PERFORM_DELIVERIES=no
DF_MAIL_DELIVERY_METHOD=smtp
DF_SMTP_ADDRESS=
DF_SMTP_PORT=
DF_SMTP_DOMAIN=
DF_SMTP_USERNAME=
DF_SMTP_PASSWORD=
DF_SMTP_AUTHENTICATION=

# Error notifications
DF_EMAIL_ERRORS_TO=ontrack-admin@example.edu


# --- TURNITIN ---

TII_ENABLED=0
TII_INDEX_SUBMISSIONS=0
TII_REGISTER_WEBHOOK=0
# TCA_API_KEY=
TCA_HOST=https://example.turnitin.com


# --- JPLAG ---

# Use -1 to store and display all comparisons.
DF_JPLAG_MAX_SHOWN_COMPARISONS=-1

# Smaller values increase sensitivity but may produce more false positives.
DF_JPLAG_MIN_TOKENS=-1
DF_JPLAG_SKIP_CLUSTER_CHECK=true


# --- OVERSEER ---

OVERSEER_ENABLED=0

# Work directory on the host used to isolate each Overseer execution.
OVERSEER_WORKDIR_VOLUME_MOUNT=/host/path/to/production/api/tmp/overseer

# Optional container fallback when a physical host mount cannot be used.
# Leave unset when OVERSEER_WORKDIR_VOLUME_MOUNT is configured.
# OVERSEER_FALLBACK_VOLUME_CONTAINER=doubtfire-overseer

# Delay before notifying students about unread failed assessments.
OVERSEER_STUDENT_NOTIFICATION_GRACE_PERIOD_MINUTES=30

# Docker registry access
DOCKER_REGISTRY_URL=
DOCKER_PROXY_URL=
DOCKER_TOKEN=
DOCKER_USER=

# Expose host storage availability in the Overseer Images admin interface.
DISK_SPACE_ENDPOINT_ENABLED=true


# --- MODERATION ---

# Scales changes to tutor feedback scores and moderation probability.
MODERATION_SCORE_FACTOR=1.0


# --- ERROR REPORTING ---

# Sentry
# SENTRY_DSN=https://xxxxxxxxxxx.ingest.de.sentry.io/xxxxxxxxxxx
SENTRY_ENVIRONMENT=production
