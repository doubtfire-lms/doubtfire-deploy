# HOST=https://example.com

PORT=3001

NODE_ENV=production

PLATFORM_URL=https://moodle.example.com # Moodle URL
PLATFORM_NAME=Moodle

# This can only be set once OnTrack has been added as an external tool to Moodle
PLATFORM_CLIENT_ID=

PLATFORM_AUTHENTICATION_ENDPOINT=https://moodle.example.com/mod/lti/auth.php
PLATFORM_ACCESS_TOKEN_ENDPOINT=https://moodle.example.com/mod/lti/token.php
PLATFORM_AUTHCONFIG_METHOD=JWK_SET
PLATFORM_AUTHCONFIG_KEY=hhttps://moodle.example.com/mod/lti/certs.php

DB_HOST=mongodb
DB_NAME=lti-db
DB_USER=lti
DB_PASS=your-mongodb-root-password


# Use `openssl rand -hex 32` to generate a random LTI key
LTI_KEY=

# Use `openssl rand -hex 32` to generated random secret that used by LTI.js and the Rails API
# Must be defined and match the same secret in the Rails API .env.production
LTI_SHARED_API_SECRET=your-secret-lti-shared-api-secret
