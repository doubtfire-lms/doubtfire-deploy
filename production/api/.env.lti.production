# HOST=https://example.com

PORT=3001

NODE_ENV=production

PLATFORM_URL=http://localhost # Moodle URL
PLATFORM_NAME=Moodle

# This can only be set once OnTrack has been added as an external tool to Moodle
PLATFORM_CLIENT_ID=

PLATFORM_AUTHENTICATION_ENDPOINT=http://localhost/mod/lti/auth.php
PLATFORM_ACCESS_TOKEN_ENDPOINT=http://localhost/mod/lti/token.php
PLATFORM_AUTHCONFIG_METHOD=JWK_SET
PLATFORM_AUTHCONFIG_KEY=http://localhost/mod/lti/certs.php

DB_HOST=mongodb
DB_NAME=lti-db
DB_USER=
DB_PASS=


LTI_KEY=

# Must be defined and match the same secret in the Rails API .env
LTI_SHARED_API_SECRET=
